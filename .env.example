# ---------------------------------------------------------------------------
# NoteWise AI — environment configuration
# Copy this file to `.env.local` and fill in the values you need.
# Never commit `.env.local`.
# ---------------------------------------------------------------------------

# AI provider. Supported values: "openai" (any OpenAI-compatible endpoint),
# "gemini" (Google AI Studio), or "none" to force local analysis mode.
AI_PROVIDER=openai

# --- OpenAI / OpenAI-compatible -------------------------------------------
AI_API_KEY=
# Change this if you use Groq, Together, OpenRouter, Ollama, Azure, etc.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Google Gemini ---------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Behaviour -------------------------------------------------------------
# Max characters of source text sent to the model in one request.
AI_MAX_INPUT_CHARS=48000
# Enable the small "Ask AI" chat about an uploaded document.
AI_ENABLE_CHAT=true
